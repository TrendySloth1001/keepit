{
  "name": "keepit-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Modular Express backend with TypeScript and Prisma",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
