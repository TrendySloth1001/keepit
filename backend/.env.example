PORT=3009
POSTGRES_URL="postgresql://keepit:keepit@localhost:5432/keepit?schema=public"

MINIO_ENDPOINT="http://localhost:9000"
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"
MINIO_BUCKET="keepit"
MINIO_ACCESS_KEY="keepitadmin"
MINIO_SECRET_KEY="keepitsecret"
MINIO_REGION="us-east-1"
MINIO_USE_SSL=false

# Comma-separated list of Google OAuth client IDs accepted by the verifier.
# Add the iOS, Android, and Web client IDs from your Google Cloud project.
GOOGLE_CLIENT_IDS="REPLACE_ME.apps.googleusercontent.com"

# 32+ chars. Generate with: openssl rand -hex 32
JWT_SECRET="dev-only-change-me-please-32+chars-min!!"
JWT_TTL_SECONDS=2592000

USER_QUOTA_BYTES=524288000
MAX_UPLOAD_BYTES=52428800
