generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VaultItemType {
  password
  note
  key
  file
  image
}

model User {
  id              String   @id @default(cuid())
  googleSub       String   @unique
  email           String   @unique
  name            String
  avatarUrl       String?

  masterSalt      String?
  masterVerifier  String?
  masterParams    Json?

  // X25519 sharing keypair. The public key is shared freely (used by other
  // users to wrap a per-share DEK with `crypto_box_seal`). The private key
  // is encrypted client-side with the master key and stored as a base64
  // ciphertext + IV here so it can be restored on any device after unlock.
  // Server never sees the plaintext private key.
  sharingPublicKey       String?
  sharingPrivateCipher   String?
  sharingPrivateIv       String?

  quotaBytes      BigInt   @default(262144000)
  bytesUsed       BigInt   @default(0)
  policyAcceptedVersion String?
  policyAcceptedAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        Session[]
  vaultItems      VaultItem[]
  vaultFolders    VaultFolder[]
  sharesSent      VaultShare[] @relation("SharesSent")
  sharesReceived  VaultShare[] @relation("SharesReceived")
  shareBundlesSent     VaultShareBundle[] @relation("BundlesSent")
  shareBundlesReceived VaultShareBundle[] @relation("BundlesReceived")
  collabFoldersOwned   CollabFolder[] @relation("CollabFolderOwner")
  collabMemberships    CollabMember[]
  collabItemsCreated   CollabItem[]
  collabItemKeys       CollabItemKey[]
  collabActivities     CollabActivity[]

  @@index([email])
}

/// Per-user vault folder. Plaintext name (mirrors VaultItem.title — owners
/// already accept that titles are visible to the server). Items are linked via
/// VaultItem.folderId; deleting a folder only nulls the link, never the items.
model VaultFolder {
  id          String   @id @default(cuid())
  userId      String
  name        String
  iconKey     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       VaultItem[]

  @@index([userId, createdAt(sort: Desc)])
}

/// An end-to-end-encrypted item share. The owner re-encrypts the item content
/// with a fresh DEK, then wraps that DEK with the recipient's public key
/// (`crypto_box_seal`). Server stores ciphertext + wrapped DEK and routes
/// access by `recipientId`. No one but the recipient (whose private key is
/// derived from their master password) can decrypt — even with the share id.
model VaultShare {
  id              String   @id @default(cuid())

  ownerId         String
  recipientId     String

  // Mirrors VaultItem.type so recipient can render the right view without
  // decrypting; this column is *not* sensitive.
  type            VaultItemType
  // Plaintext title shown in the recipient's "Shared with me" list. Owners
  // are warned that titles are visible to the server (consistent with the
  // existing item title column).
  title           String

  // The item payload encrypted with a per-share DEK.
  cipherBlob      Bytes
  cipherIv        Bytes
  // The DEK itself, sealed with the recipient's public key (X25519 sealed
  // box). Only the recipient can decrypt this.
  wrappedKey      Bytes

  permission      String   @default("view") // "view" | "edit" (edit reserved)

  // For file/image shares: the owner's source VaultItem id. The encrypted
  // body lives on that item; the recipient fetches it via /shares/:id/content
  // (the per-file DEK rides inside the encrypted share payload). Null for
  // non-file shares and for legacy shares that inlined fileBase64.
  sourceItemId    String?

  // Optional bundle membership. When set, this share is one entry in a
  // shared folder snapshot — listed under the bundle's name in the UI and
  // revoked together. SET NULL on bundle delete so individual share rows
  // survive even if the bundle row is removed.
  bundleId        String?

  // Read receipts: server-tracked, not user-supplied. firstOpenedAt is set
  // exactly once on the first decrypt; lastOpenedAt + openCount are updated
  // on every subsequent open. File shares bump these in /shares/:id/content;
  // non-file shares hit POST /shares/:id/opened from the client after decrypt.
  firstOpenedAt   DateTime?
  lastOpenedAt    DateTime?
  openCount       Int      @default(0)

  createdAt       DateTime @default(now())
  revokedAt       DateTime?
  // Optional auto-revoke timestamp. listReceived/listSent filter
  // `expiresAt is null OR expiresAt > now()` so expired rows disappear from
  // either side without a separate sweep job.
  expiresAt       DateTime?

  owner           User     @relation("SharesSent", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient       User     @relation("SharesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  bundle          VaultShareBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([recipientId, revokedAt, expiresAt, createdAt(sort: Desc)])
  @@index([ownerId, expiresAt, createdAt(sort: Desc)])
  @@index([bundleId])
}

/// A snapshot share of a folder: groups N VaultShare rows under one logical
/// "folder share" for the recipient. Read-only (Phase 1) — children are
/// individual sealed snapshots and adding/removing items from the source
/// folder later does NOT auto-update the bundle.
model VaultShareBundle {
  id          String   @id @default(cuid())
  ownerId     String
  recipientId String
  // Plaintext label shown in both inboxes — same trust model as share titles.
  name        String
  // Optional source folder pointer (owner-side). Null if the original folder
  // is later deleted; the bundle remains valid because its child shares are
  // independent encrypted snapshots.
  sourceFolderId String?

  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  owner       User      @relation("BundlesSent", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient   User      @relation("BundlesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  shares      VaultShare[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([recipientId, revokedAt, expiresAt, createdAt(sort: Desc)])
}

model PrivacyPolicy {
  id          String   @id @default("active")
  version     String
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  jtiHash      String    @unique
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VaultItem {
  id              String        @id @default(cuid())
  userId          String
  type            VaultItemType
  title           String
  cipherBlob      Bytes
  cipherIv        Bytes
  fileObjectKey   String?       @unique
  fileSize        BigInt?
  fileMime        String?
  uploadStatus    String?
  multipartUploadId String?

  // Optional folder grouping. SET NULL on folder delete so items survive a
  // folder removal — folders are pure organization, not ownership.
  folderId        String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder          VaultFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadParts     VaultUploadPart[]

  @@index([userId, type, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, folderId, updatedAt(sort: Desc)])
}

model VaultUploadPart {
  id          String    @id @default(cuid())
  itemId       String
  partNumber   Int
  sizeBytes    BigInt
  eTag         String
  createdAt    DateTime @default(now())

  item         VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, partNumber])
  @@index([itemId])
}

/// Collaborative shared folder. Distinct from VaultShareBundle (which is a
/// frozen snapshot): members can post new items and see each other's posts
/// in real time. Each item is encrypted under a per-item DEK that is wrapped
/// to every current member's sharing public key (one CollabItemKey row per
/// member per item).
///
/// Edit policy: only the item creator may edit/delete their own items.
/// Member removal in v1 simply revokes future-key access — past items remain
/// readable by any device that already cached them. Key rotation can be
/// added later if compliance needs it.
model CollabFolder {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  iconKey     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation("CollabFolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CollabMember[]
  items       CollabItem[]
  activities  CollabActivity[]

  @@index([ownerId, createdAt(sort: Desc)])
}

/// Membership row. Owner is automatically inserted as the first member at
/// folder creation. Role gates capability: 'owner' may invite/remove members
/// and delete the folder; 'member' may post items and read all items.
model CollabMember {
  id          String   @id @default(cuid())
  folderId    String
  userId      String
  role        String   @default("member") // "owner" | "member"
  joinedAt    DateTime @default(now())

  folder      CollabFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKeys    CollabItemKey[]

  @@unique([folderId, userId])
  @@index([userId])
  @@index([folderId])
}

/// One credential inside a collaborative folder. cipherBlob/cipherIv hold
/// the AES-GCM ciphertext under the per-item DEK. The DEK itself never
/// touches the server in plaintext — recipients unwrap their own copy from
/// CollabItemKey.
model CollabItem {
  id          String   @id @default(cuid())
  folderId    String
  creatorId   String
  type        VaultItemType
  // Plaintext title — same trust model as VaultItem.title.
  title       String
  cipherBlob  Bytes
  cipherIv    Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folder      CollabFolder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  creator     User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  keys        CollabItemKey[]

  @@index([folderId, createdAt(sort: Desc)])
  @@index([creatorId])
}

/// Per-member sealed copy of a CollabItem's DEK. The poster wraps the DEK
/// to every current member's sharing public key when the item is created;
/// each member unwraps their own row to decrypt the cipher blob.
model CollabItemKey {
  id          String   @id @default(cuid())
  itemId      String
  memberId    String   // CollabMember.id
  userId      String   // denormalized for direct lookup by user
  wrappedKey  Bytes

  item        CollabItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member      CollabMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
  @@index([itemId])
}

/// Append-only audit log of folder activity, visible to all members.
/// action ∈ {"created", "invited", "joined", "left", "post_item",
///           "edit_item", "delete_item", "viewed_item"}.
model CollabActivity {
  id          String   @id @default(cuid())
  folderId    String
  actorId     String
  action      String
  targetItemId String?
  // Optional human-readable detail (e.g. invited user's email, item title
  // at time of action). No sensitive data — never the cipher.
  detail      String?
  createdAt   DateTime @default(now())

  folder      CollabFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  actor       User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([folderId, createdAt(sort: Desc)])
}
